---
import type { MarkdownHeading } from "astro";
import Categories from "./Categories.astro";
import RecentPosts from "./RecentPosts.astro";
import Tag from "./Tags.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
}

const className = Astro.props.class;
---
<aside id="sidebar" class:list={[className, "w-full lg:w-[12.5rem]"]}>
    <div id="sidebar-sticky" class="transition-all duration-700 flex flex-col w-full gap-10 top-4 sticky">
        <RecentPosts class="onload-animation" style="animation-delay: 150ms"></RecentPosts>
        <Categories class="onload-animation" style="animation-delay: 200ms"></Categories>
        <Tag class="onload-animation" style="animation-delay: 250ms"></Tag>
    </div>
</aside>
