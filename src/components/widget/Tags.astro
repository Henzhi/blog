---
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import { getTagList } from "../../utils/content-utils";
import { getTagUrl, url } from "../../utils/url-utils";
import WidgetLayout from "./WidgetLayout.astro";

const tags = await getTagList();

// 只展示热度最高的 8 个，剩下的进存档页筛选
const topTags = [...tags].sort((a, b) => b.count - a.count).slice(0, 8);

interface Props {
	class?: string;
	style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;
---

<WidgetLayout name={i18n(I18nKey.tags)} id="tags" class={className} style={style}>
    <div class="flex gap-2 flex-wrap">
        {topTags.map(t => (
            <a href={getTagUrl(t.name)} aria-label={`View all posts with the ${t.name.trim()} tag`}
               class="inline-flex items-center h-7 px-2.5 rounded-md text-[0.8125rem] text-75
                      border border-[var(--border-subtle)] bg-transparent
                      transition-colors hover:border-[var(--primary)] hover:text-[var(--primary)]">
                {t.name.trim()}
            </a>
        ))}
    </div>
    {tags.length > topTags.length && (
        <a href={url('/archive/')} class="inline-block mt-3 text-[0.8125rem] text-50 transition-colors hover:text-[var(--primary)]">
            全部标签 →
        </a>
    )}
</WidgetLayout>
