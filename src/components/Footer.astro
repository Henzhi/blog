---

import { profileConfig } from "../config";
import { url } from "../utils/url-utils";

const currentYear = new Date().getFullYear();
---

<div class="transition my-10" style="border-top: 0.5px solid var(--border-subtle)"></div>
<div class="mb-12 flex flex-col items-center justify-center px-6">
    <div class="transition text-30 text-[0.8125rem] text-center leading-relaxed">
        &copy; <span id="copyright-year">{currentYear}</span> {profileConfig.name} ·
        <a class="transition link text-[var(--primary)]" target="_blank" href={url('rss.xml')}>RSS</a> ·
        <a class="transition link text-[var(--primary)]" target="_blank" href={url('sitemap-index.xml')}>Sitemap</a><br>
        Powered by
        <a class="transition link text-[var(--primary)]" target="_blank" href="https://astro.build">Astro</a> &
        <a class="transition link text-[var(--primary)]" target="_blank" href="https://github.com/saicaca/fuwari">Fuwari</a>
    </div>
</div>
