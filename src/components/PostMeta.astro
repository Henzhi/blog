---
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getCategoryUrl, getTagUrl } from "../utils/url-utils";

interface Props {
	class?: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	hideTagsForMobile?: boolean;
	hideUpdateDate?: boolean;
}
const {
	published,
	updated,
	tags,
	category,
	hideTagsForMobile = false,
	hideUpdateDate = false,
} = Astro.props;
const className = Astro.props.class;

const showUpdated =
	!hideUpdateDate && updated && updated.getTime() !== published.getTime();
---

<!-- 元信息行：日期 · 更新 · 分类 · 标签，13px 次级色，无图标盒子 -->
<div class:list={["flex flex-wrap items-baseline gap-x-2 gap-y-1 text-[0.8125rem] text-30", className]}>
    <time class="tabular-nums">{formatDateToYYYYMMDD(published)}</time>

    {showUpdated && (
        <>
            <span aria-hidden="true">·</span>
            <span>更新于 <time class="tabular-nums">{formatDateToYYYYMMDD(updated)}</time></span>
        </>
    )}

    <span aria-hidden="true">·</span>
    <a href={getCategoryUrl(category)}
       aria-label={`View all posts in the ${category} category`}
       class="transition-colors hover:text-[var(--primary)]">
        {category || i18n(I18nKey.uncategorized)}
    </a>

    {(tags && tags.length > 0) && (
        <>
            <span aria-hidden="true" class:list={[{"hidden": hideTagsForMobile}, "md:inline"]}>·</span>
            <span class:list={[{"hidden": hideTagsForMobile}, "md:inline flex-wrap items-baseline gap-x-1"]}>
                {tags.map((tag, i) => (
                    <>
                        {i > 0 && <span aria-hidden="true" class="mx-0.5">/</span>}
                        <a href={getTagUrl(tag)}
                           aria-label={`View all posts with the ${tag.trim()} tag`}
                           class="transition-colors hover:text-[var(--primary)]">
                            {tag.trim()}
                        </a>
                    </>
                ))}
            </span>
        </>
    )}
</div>
