---
import type { Project } from '../data/projects';
interface Props {
  project: Project;
}
const { project } = Astro.props;
---
<article class="card">
  <h3>{project.name}</h3>
  <p>{project.description}</p>
  <div class="meta">
    {project.tags.map((t) => <span class="tag">#{t}</span>)}
    {project.link && <a href={project.link} target="_blank" rel="noopener">查看 →</a>}
  </div>
</article>
