---
import type { Project } from '../data/projects';
interface Props {
  project: Project;
}
const { project } = Astro.props;
---
<article class="card">
  <h3>{project.name}</h3>
  {project.status && (
    <div class="meta-row">
      <span>● {project.status}</span>
      {project.year && <span>{project.year}</span>}
    </div>
  )}
  <p class="desc">{project.description}</p>
  <div class="tags">
    {project.tags.map((t) => <span class="tag">{t}</span>)}
  </div>
  <div class="links">
    {project.link && <a href={project.link} target="_blank" rel="noopener">代码仓库 →</a>}
    {project.demo && <a href={project.demo} target="_blank" rel="noopener">在线演示 →</a>}
  </div>
</article>
