---
import { profileConfig } from "../config";
import { url } from "../utils/url-utils";

// Default 档：三句话以内，说清「这儿写什么」
const shortBio =
	"写点日常生活，整理学习笔记，也把折腾过的东西写成能照着做的教程。";
// Long 档：补充写东西的态度，给愿意深读的人
const longBio =
	"这里不做选题规划，也不追热点——想清楚了就写，写完就算是给自己存了一份档。技术上的折腾、读过的东西、日常里那些值得记一笔的事，都放在这儿。";
---

<hero-section class="block pt-10 pb-12 md:pt-14 md:pb-16">
    <div class="flex items-center gap-4 md:gap-5">
        <!-- GitHub 头像（外链，跟随 GitHub 资料自动更新） -->
        <img src={profileConfig.avatar} alt={`${profileConfig.name} 的 GitHub 头像`}
             width="64" height="64" loading="eager" decoding="async"
             class="shrink-0 w-14 h-14 md:w-16 md:h-16 rounded-full object-cover select-none" />
        <div class="min-w-0">
            <h1 class="text-[length:var(--text-hero)] leading-[1.1] font-semibold text-black/90 dark:text-white/90 tracking-tight">
                {profileConfig.name}
            </h1>
            <div class="mt-1 text-[0.9375rem] text-50">
                生活记录 · 学习笔记 · 教程笔记
            </div>
        </div>
    </div>

    <div class="mt-6 max-w-[42rem]">
        <p class="bio-short text-[length:var(--text-body)] leading-[1.75] text-black/80 dark:text-white/80">
            {shortBio}
        </p>
        <p class="bio-long hidden text-[length:var(--text-body)] leading-[1.75] text-black/80 dark:text-white/80">
            {shortBio}{longBio}
        </p>
        <button class="bio-toggle mt-2 text-[0.8125rem] text-30 transition-colors hover:text-[var(--primary)]">
            <span class="bio-toggle-label">展开完整简介 ↓</span>
        </button>
    </div>

    <div class="mt-8 flex flex-wrap gap-3">
        <a href={url('/categories/')}
           class="btn-regular rounded-lg h-10 px-5 text-[0.9375rem] font-medium active:scale-95">
            按分类浏览 →
        </a>
        <a href={url('/archive/')}
           class="btn-plain rounded-lg h-10 px-5 text-[0.9375rem] font-medium border border-[var(--border-subtle)] active:scale-95">
            读文章 →
        </a>
    </div>
</hero-section>

<script>
    class HeroSection extends HTMLElement {
        constructor() {
            super();
            const btn = this.querySelector('.bio-toggle');
            const label = this.querySelector('.bio-toggle-label');
            const short = this.querySelector('.bio-short');
            const long = this.querySelector('.bio-long');
            let expanded = false;
            btn?.addEventListener('click', () => {
                expanded = !expanded;
                short?.classList.toggle('hidden', expanded);
                long?.classList.toggle('hidden', !expanded);
                if (label) label.textContent = expanded ? '收起 ↑' : '展开完整简介 ↓';
            });
        }
    }

    if (!customElements.get('hero-section')) {
        customElements.define('hero-section', HeroSection);
    }
</script>
