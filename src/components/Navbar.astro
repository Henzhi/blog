---
import { Icon } from "astro-icon/components";
import { navBarConfig, siteConfig } from "../config";
import { LinkPresets } from "../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../types/config";
import { pathsEqual, url } from "../utils/url-utils";
import LightDarkSwitch from "./LightDarkSwitch.svelte";
import Search from "./Search.svelte";
import DisplaySettings from "./widget/DisplaySettings.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";

const className = Astro.props.class;

let links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return LinkPresets[item];
		}
		return item;
	},
);
---
<div id="navbar" class="z-50 onload-animation">
    <nav aria-label="主导航" class:list={[
        className,
        "!overflow-visible max-w-[var(--page-width)] h-16 mt-2 mx-auto flex items-center justify-between px-0",
        "nav-shell"]}>
        <a href={url('/')} class="btn-plain scale-animation rounded-full h-10 px-3 md:px-4 font-semibold active:scale-95 min-w-0">
            <div class="flex min-w-0 items-center text-[0.9375rem] md:text-base">
                <span class="nav-logo-dot mr-2.5 shrink-0" aria-hidden="true"></span>
                <span class="truncate">{siteConfig.title}</span>
            </div>
        </a>
        <div class="hidden md:flex">
            {links.map((l) => {
                // 当前页导航项用 accent 色——全站仅两处彩色用法之一（另一处是正文链接）
                const isCurrent = !l.external && pathsEqual(Astro.url.pathname, url(l.url));
                return <a aria-label={l.name} href={l.external ? l.url : url(l.url)} target={l.external ? "_blank" : null}
                          data-nav-link={l.external ? undefined : url(l.url)}
                          class:list={["btn-plain scale-animation rounded-full h-10 font-semibold px-3.5 md:px-4 active:scale-95",
                              {"!text-[var(--primary)]": isCurrent}]}
                >
                    <div class="flex items-center">
                        {l.name}
                        {l.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.875rem] transition -translate-y-[1px] ml-1 text-black/[0.2] dark:text-white/[0.2]"></Icon>}
                    </div>
                </a>;
            })}
        </div>
        <div class="flex pr-3 md:pr-4">
            <!--<SearchPanel client:load>-->
            <Search client:only="svelte"></Search>
            {!siteConfig.themeColor.fixed && (
                    <button aria-label="Display Settings" class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="display-settings-switch">
                        <Icon name="material-symbols:palette-outline" class="text-[1.25rem]"></Icon>
                    </button>
            )}
            <LightDarkSwitch client:only="svelte"></LightDarkSwitch>
            <button aria-label="打开导航菜单" class="btn-plain scale-animation rounded-full w-10 h-10 active:scale-90 md:!hidden" id="nav-menu-switch">
                <Icon name="material-symbols:menu-rounded" class="text-[1.25rem]"></Icon>
            </button>
        </div>
        <NavMenuPanel links={links}></NavMenuPanel>
        <!-- 主题色锁定时（siteConfig.themeColor.fixed）这个面板没有任何入口，
             再挂载它只会在首屏白白加载一个 chunk。 -->
        {!siteConfig.themeColor.fixed && <DisplaySettings client:only="svelte"></DisplaySettings>}
    </nav>
</div>

<style is:global>
    .nav-shell {
        border: 1px solid var(--border-subtle);
        border-radius: 999px;
        background: var(--float-panel-bg);
        box-shadow: var(--shadow-nav);
        backdrop-filter: blur(18px);
    }
    .nav-logo-dot {
        width: 0.75rem;
        height: 0.75rem;
        border-radius: 999px;
        background: linear-gradient(135deg, var(--primary), var(--rose));
        box-shadow: 0 0 0 4px var(--primary-soft);
    }
</style>

<script>
import { pathsEqual } from "../utils/url-utils";

/* Navbar 不在 swup 的替换容器里，当前页高亮必须跟着 URL 主动同步。
   外链不参与高亮；data-nav-link 在模板里只给站内链接输出。 */
function syncCurrentNav() {
    document.querySelectorAll<HTMLAnchorElement>("#navbar a[data-nav-link]").forEach((link) => {
        const target = link.dataset.navLink;
        if (!target) return;
        link.classList.toggle("!text-[var(--primary)]", pathsEqual(window.location.pathname, target));
    });
}

function loadButtonScript() {
    let settingBtn = document.getElementById("display-settings-switch");
    if (settingBtn) {
        settingBtn.onclick = function () {
            let settingPanel = document.getElementById("display-setting");
            if (settingPanel) {
                settingPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    let menuBtn = document.getElementById("nav-menu-switch");
    if (menuBtn) {
        menuBtn.onclick = function () {
            let menuPanel = document.getElementById("nav-menu-panel");
            if (menuPanel) {
                menuPanel.classList.toggle("float-panel-closed");
            }
        };
    }
}

loadButtonScript();
syncCurrentNav();

const setupNavbarSync = () => {
    window.swup.hooks.on("page:view", syncCurrentNav);
};
if (window.swup) {
    setupNavbarSync();
} else {
    document.addEventListener("swup:enable", setupNavbarSync, { once: true });
}
</script>

{import.meta.env.PROD && <script is:inline define:vars={{scriptUrl: url('/pagefind/pagefind.js')}}>
let pagefindStarted = false;

async function loadPagefind() {
    try {
        const response = await fetch(scriptUrl, { method: 'HEAD' });
        if (!response.ok) {
            throw new Error(`Pagefind script not found: ${response.status}`);
        }

        const pagefind = await import(scriptUrl);

        await pagefind.options({
            excerptLength: 20
        });

        window.pagefind = pagefind;

        document.dispatchEvent(new CustomEvent('pagefindready'));
    } catch (error) {
        console.error('Failed to load Pagefind:', error);
        window.pagefind = {
            search: () => Promise.resolve({ results: [] }),
            options: () => Promise.resolve(),
        };
        document.dispatchEvent(new CustomEvent('pagefindloaderror'));
    }
}

/**
 * Pagefind 延后加载。
 * 索引运行时代码（pagefind.js 约 44KB + wasm）原来在首屏就下载，但「打开页面
 * 立刻搜索」并不是真实路径 —— 用户总要先有搜索动作。所以改成挂到搜索意图上：
 * 悬停或聚焦搜索框、按 Ctrl/⌘+K、以及 Search 组件在等待就绪时主动催一次。
 * 最后再留一个空闲兜底，避免第一次搜索干等。
 */
function startPagefind() {
    if (pagefindStarted) return;
    pagefindStarted = true;
    void loadPagefind();
}

// Search 组件在「用户已输入但索引还没就绪」时会调用它
window.__startPagefind = startPagefind;

function schedulePagefindLoad() {
    for (const id of ['search-bar', 'search-switch', 'search-bar-inside']) {
        const el = document.getElementById(id);
        if (!el) continue;
        el.addEventListener('pointerenter', startPagefind, { once: true });
        el.addEventListener('focusin', startPagefind, { once: true });
    }

    document.addEventListener('keydown', (event) => {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
            startPagefind();
        }
    });

    if (typeof window.requestIdleCallback === 'function') {
        window.requestIdleCallback(() => startPagefind(), { timeout: 6000 });
    } else {
        setTimeout(startPagefind, 3000);
    }
}

if (!window.__pagefindLoadScheduled) {
    window.__pagefindLoadScheduled = true;
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', schedulePagefindLoad);
    } else {
        schedulePagefindLoad();
    }
}
</script>}
