---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<BaseLayout title="博客 · Henzhi">
  <h1>博客</h1>
  <p class="lead" style="margin-bottom:24px">技术笔记、项目复盘与一些零碎思考。</p>
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <a href={`/blog/${post.slug}`} style="font-size:18px;font-weight:700">{post.data.title}</a>
        <div class="date">{post.data.pubDate.toLocaleDateString('zh-CN')}</div>
        <p style="margin:8px 0 0;color:var(--muted)">{post.data.description}</p>
        <div class="tags">{post.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
      </li>
    ))}
  </ul>
</BaseLayout>
