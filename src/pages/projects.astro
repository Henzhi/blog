---
import { Icon } from "astro-icon/components";
import { projects, toneColor } from "../data/projects";
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout title="作品集" description="Henzhi 的开源项目">
    <div class="pt-2 pb-4">
        <div class="mb-8 onload-animation">
            <h1 class="text-[length:var(--text-h1)] font-semibold text-black/90 dark:text-white/90 tracking-tight">作品集</h1>
            <p class="mt-2 text-[0.9375rem] text-50">在做的和做过的项目，全部开源在 GitHub。</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {projects.map((p, i) => (
                <a href={p.repo} target="_blank" rel="noopener"
                   class:list={[
                       "project-card group relative rounded-[var(--radius-lg)] border border-[var(--border-subtle)] p-5 pl-6",
                       "transition-colors hover:border-[var(--primary)] hover:bg-[var(--bg-elevated)] onload-animation",
                   ]}
                   style={`animation-delay: calc(var(--content-delay) + ${i * 50}ms)`}
                >
                    <!-- 状态色条：进行中=accent / 维护中=绿 / 重构中=琥珀 -->
                    <span class="absolute left-0 top-5 bottom-5 w-[3px] rounded-full"
                          style={`background: ${toneColor[p.tone]}`}></span>

                    <div class="flex items-baseline justify-between gap-2">
                        <h2 class="text-[1.125rem] font-medium text-black/90 dark:text-white/90 transition-colors group-hover:text-[var(--primary)]">
                            {p.name}
                        </h2>
                        <span class="shrink-0 text-[0.8125rem]" style={`color: ${toneColor[p.tone]}`}>{p.status}</span>
                    </div>

                    <p class="mt-2 text-[0.9375rem] leading-relaxed text-50">{p.desc}</p>

                    <div class="mt-4 flex items-baseline justify-between gap-3 pr-5">
                        <span class="min-w-0 truncate text-[0.8125rem] text-30">{p.stack.join(" · ")}</span>
                        <span class="shrink-0 text-[0.8125rem] text-30 tabular-nums">{p.year}</span>
                    </div>

                    <Icon name="fa6-solid:arrow-up-right-from-square"
                          class="absolute right-4 bottom-4 text-[0.75rem] text-30 opacity-0 transition-opacity group-hover:opacity-100" />
                </a>
            ))}
        </div>
    </div>
</MainGridLayout>
