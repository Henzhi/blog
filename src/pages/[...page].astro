---
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";
import Pagination from "../components/control/Pagination.astro";
import Hero from "../components/Hero.astro";
import PostPage from "../components/PostPage.astro";
import { PAGE_SIZE } from "../constants/constants";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../utils/content-utils";
import { url } from "../utils/url-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	return paginate(allBlogPosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const { page } = Astro.props;

const isFirstPage = page.currentPage === 1;
---

<MainGridLayout>
    {isFirstPage ? (
        <Hero></Hero>

        <section id="latest" class="section-header mt-10 mb-5 flex flex-wrap items-end justify-between gap-4 onload-animation" style="animation-delay: 150ms">
            <div>
                <div class="page-kicker">RECENT NOTES</div>
                <h2 class="mt-2 text-[1.5rem] md:text-[1.75rem] leading-tight font-semibold tracking-[-0.03em] text-90">最新文章</h2>
            </div>
            <a href={url('/archive/')}
               class="inline-flex items-center gap-1 min-h-10 px-4 rounded-full text-[0.875rem] font-medium text-50 bg-[var(--card-bg)] border border-[var(--border-subtle)] transition hover:text-[var(--primary)] hover:border-[var(--primary)] active:scale-[0.98]">
                全部文章
                <Icon name="material-symbols:arrow-right-alt-rounded" class="text-lg" />
            </a>
        </section>
    ) : (
        <header class="page-hero onload-animation mb-6">
            <div class="page-kicker">ARCHIVE</div>
            <h1 class="mt-2 text-[length:var(--text-h1)] leading-tight font-semibold tracking-[-0.03em] text-90">文章列表</h1>
            <p class="mt-2 text-[0.9375rem] text-50 tabular-nums">第 {page.currentPage} 页 / 共 {page.lastPage} 页</p>
        </header>
    )}

    <PostPage page={page}></PostPage>

    {page.lastPage > 1 && (
        <Pagination class="mx-auto onload-animation mt-8" page={page} style={`animation-delay: calc(var(--content-delay) + ${page.data.length * 50}ms)`}></Pagination>
    )}
</MainGridLayout>
