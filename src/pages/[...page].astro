---
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";
import Pagination from "../components/control/Pagination.astro";
import Hero from "../components/Hero.astro";
import PostPage from "../components/PostPage.astro";
import { PAGE_SIZE } from "../constants/constants";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../utils/content-utils";
import { url } from "../utils/url-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	return paginate(allBlogPosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const { page } = Astro.props;

const len = page.data.length;
const isFirstPage = page.currentPage === 1;
---

<MainGridLayout>
    {isFirstPage && (
        <Hero></Hero>

        <div class="section-label mb-1 onload-animation" id="latest" style="animation-delay: 150ms">最新文章</div>
    )}

    <PostPage page={page}></PostPage>

    {isFirstPage && (
        <a href={url('/archive/')}
           class="inline-flex items-center gap-1 mt-2 text-[0.9375rem] text-50 transition-colors hover:text-[var(--primary)] onload-animation"
           style={`animation-delay: calc(var(--content-delay) + ${len * 50 + 150}ms)`}
        >
            全部文章
            <Icon name="material-symbols:arrow-right-alt-rounded" class="text-lg" />
        </a>
    )}

    {page.lastPage > 1 && (
        <Pagination class="mx-auto onload-animation mt-6" page={page} style={`animation-delay: calc(var(--content-delay) + ${(len)*50}ms)`}></Pagination>
    )}
</MainGridLayout>
