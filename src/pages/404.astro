---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import { url } from "../utils/url-utils";

// 打错的地址、失效的外链、旧文章迁移后的老 URL 都会落到这里。
// 目标只有一个：让访客一条路回到站内，而不是关掉页面。
const links = [
	{ name: "首页", desc: "最新的文章列表", href: url("/") },
	{
		name: "分类",
		desc: "生活记录 / 学习笔记 / 教程笔记",
		href: url("/categories/"),
	},
	{ name: "归档", desc: "全部文章，按时间排列", href: url("/archive/") },
	{ name: "关于", desc: "这个站和我", href: url("/about/") },
];
---

<MainGridLayout title="页面不存在" description="没有找到这个页面，可能是链接失效或地址写错了。">
    <div class="max-w-[42rem] mx-auto pt-2">
        <div class="onload-animation">
            <p class="font-mono text-[0.8125rem] tracking-[0.12em] text-30">404</p>
            <h1 class="mt-2 text-[length:var(--text-h1)] font-semibold tracking-tight text-black/90 dark:text-white/90">
                这个页面不存在
            </h1>
            <p class="mt-3 text-[length:var(--text-body)] leading-[1.75] text-black/75 dark:text-white/75">
                链接可能已经失效，或者地址打错了。下面这几个地方也许找得到你要的东西。
            </p>
        </div>

        <ul class="mt-8 onload-animation" style="animation-delay: 100ms">
            {links.map((l) => (
                <li>
                    <a href={l.href}
                       class="group flex items-baseline gap-4 py-3 -mx-2 px-2 rounded-lg transition-colors hover:bg-[var(--btn-plain-bg-hover)]"
                       style="border-bottom: 0.5px solid var(--border-subtle)">
                        <span class="shrink-0 text-[0.9375rem] font-medium text-black/90 dark:text-white/90 transition-colors group-hover:text-[var(--primary)]">
                            {l.name}
                        </span>
                        <span class="min-w-0 truncate text-[0.8125rem] text-30">{l.desc}</span>
                        <Icon name="material-symbols:arrow-right-alt-rounded"
                              class="ml-auto shrink-0 text-30 transition-colors group-hover:text-[var(--primary)]" />
                    </a>
                </li>
            ))}
        </ul>

        <p class="mt-6 text-[0.9375rem] text-50 onload-animation" style="animation-delay: 200ms">
            也可以按
            <kbd class="mx-0.5 rounded border border-[var(--border-subtle)] px-1.5 py-0.5 font-mono text-[0.75rem]">Ctrl</kbd>
            或
            <kbd class="mx-0.5 rounded border border-[var(--border-subtle)] px-1.5 py-0.5 font-mono text-[0.75rem]">⌘</kbd>
            加
            <kbd class="mx-0.5 rounded border border-[var(--border-subtle)] px-1.5 py-0.5 font-mono text-[0.75rem]">K</kbd>
            直接搜索全站。
        </p>
    </div>
</MainGridLayout>
