---
import { Icon } from "astro-icon/components";
import { categoryDefs } from "../data/categories";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getSortedPostsList } from "../utils/content-utils";
import { getPostUrlBySlug, url } from "../utils/url-utils";

// 分类索引页：分类定义来自 src/data/categories.ts（即使某个分类暂时没有文章也会列出来），
// 文章按 published 倒序从 content collection 里取。
const posts = await getSortedPostsList();

const groups = categoryDefs.map((def) => {
	const matched = posts.filter(
		(p) => (p.data.category ?? "").trim() === def.name,
	);
	return {
		...def,
		count: matched.length,
		preview: matched.slice(0, 3),
		archiveUrl: url(`/archive/?category=${encodeURIComponent(def.name)}`),
	};
});

function formatYearMonth(date: Date) {
	const year = date.getFullYear();
	const month = (date.getMonth() + 1).toString().padStart(2, "0");
	return `${year} · ${month}`;
}
---

<MainGridLayout title="分类" description="按分类浏览：生活记录、学习笔记、教程笔记">
    <div class="pt-2 pb-4">
        <div class="mb-8 onload-animation">
            <h1 class="text-[length:var(--text-h1)] font-semibold text-black/90 dark:text-white/90 tracking-tight">分类</h1>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-50">
                这个站点主要写三件事。点分类名看该分类的全部文章，也可以直接读下面的几篇。
            </p>
        </div>

        <div class="flex flex-col gap-9">
            {groups.map((g, i) => (
                <section class="onload-animation" style={`animation-delay: ${100 + i * 50}ms`}>
                    <div class="flex items-baseline justify-between gap-3">
                        <h2 class="text-[1.25rem] font-medium tracking-tight">
                            {g.count > 0 ? (
                                <a href={g.archiveUrl}
                                   class="text-black/90 dark:text-white/90 transition-colors hover:text-[var(--primary)]">
                                    {g.name}
                                </a>
                            ) : (
                                /* 空分类不做成链接，避免点了跳到一个空筛选结果页 */
                                <span class="text-black/60 dark:text-white/60">{g.name}</span>
                            )}
                        </h2>
                        <span class="shrink-0 text-[0.8125rem] text-30 tabular-nums">
                            {g.count > 0 ? `${g.count} 篇` : "暂无文章"}
                        </span>
                    </div>

                    <p class="mt-1.5 text-[0.9375rem] leading-relaxed text-50">{g.tagline}</p>

                    {g.preview.length > 0 && (
                        <ul class="mt-3">
                            {g.preview.map((p) => (
                                <li>
                                    <a href={getPostUrlBySlug(p.slug)}
                                       class="group flex items-baseline gap-4 py-2 -mx-2 px-2 rounded-lg transition-colors hover:bg-[var(--btn-plain-bg-hover)]"
                                       style="border-bottom: 0.5px solid var(--border-subtle)">
                                        <span class="shrink-0 w-[5.5rem] font-mono text-[0.8125rem] tabular-nums text-30">
                                            {formatYearMonth(p.data.published)}
                                        </span>
                                        <span class="min-w-0 truncate text-[0.9375rem] text-black/90 dark:text-white/90 transition-colors group-hover:text-[var(--primary)]">
                                            {p.data.title}
                                        </span>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    )}

                    {g.count > g.preview.length && (
                        <a href={g.archiveUrl}
                           class="inline-flex items-center gap-1 mt-3 text-[0.9375rem] text-50 transition-colors hover:text-[var(--primary)]">
                            查看该分类全部 {g.count} 篇
                            <Icon name="material-symbols:arrow-right-alt-rounded" class="text-lg" />
                        </a>
                    )}
                </section>
            ))}
        </div>
    </div>
</MainGridLayout>
